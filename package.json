{
  "name": "packscout",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10.9.0 <11"
  },
  "workspaces": [
    "apps/frontend",
    "apps/admin",
    "apps/ops-panel",
    "apps/worker",
    "packages/contracts",
    "packages/database",
    "packages/services"
  ],
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    },
    "axios": "1.18.0",
    "postcss": "8.5.25",
    "sharp": "0.35.3",
    "ws": "8.21.3"
  },
  "scripts": {
    "postinstall": "npm run db:prisma:generate",
    "dev": "npm run dev:frontend",
    "dev:frontend": "npm run dev --workspace=@packscout/frontend",
    "dev:admin": "npm run dev --workspace=@packscout/admin",
    "dev:worker": "npm run dev --workspace=@packscout/worker",
    "dev:ops-panel": "npm run dev --workspace=@packscout/ops-panel",
    "dev:all": "concurrently --names 'frontend,admin' --prefix-colors 'cyan,yellow' 'npm run dev:frontend:logged:local' 'npm run dev:admin:logged:local'",
    "dev:frontend:logged:local": "node --import tsx scripts/local/run-service-with-log.mjs frontend",
    "dev:admin:logged:local": "node --import tsx scripts/local/run-service-with-log.mjs admin",
    "dev:worker:logged:local": "node --import tsx scripts/local/run-service-with-log.mjs worker",
    "dev:ops-panel:logged:local": "node --import tsx scripts/local/run-service-with-log.mjs ops-panel",
    "build": "npm run build:frontend && npm run build:admin",
    "build:frontend": "npm run build --workspace=@packscout/frontend",
    "build:admin": "npm run build --workspace=@packscout/admin",
    "lint": "concurrently -m 4 -g --names 'contracts,database,services,worker,frontend,admin,ops-panel' --prefix-colors auto 'npm:lint:contracts' 'npm:lint:database' 'npm:lint:services' 'npm:lint:worker' 'npm:lint:frontend' 'npm:lint:admin' 'npm:lint:ops-panel'",
    "lint:ops-panel": "npm run lint --workspace=@packscout/ops-panel",
    "lint:contracts": "npm run lint --workspace=@packscout/contracts",
    "lint:database": "npm run lint --workspace=@packscout/database",
    "lint:services": "npm run lint --workspace=@packscout/services",
    "lint:worker": "npm run lint --workspace=@packscout/worker",
    "lint:frontend": "npm run lint --workspace=@packscout/frontend",
    "lint:admin": "npm run lint --workspace=@packscout/admin",
    "typecheck": "concurrently -m 4 -g --names 'contracts,database,services,worker,convex,frontend,admin,ops-panel' --prefix-colors auto 'npm:typecheck:contracts' 'npm:typecheck:database' 'npm:typecheck:services' 'npm:typecheck:worker' 'npm:typecheck:convex' 'npm:typecheck:frontend' 'npm:typecheck:admin' 'npm:typecheck:ops-panel'",
    "typecheck:ops-panel": "npm run typecheck --workspace=@packscout/ops-panel",
    "typecheck:contracts": "npm run typecheck --workspace=@packscout/contracts",
    "typecheck:database": "npm run typecheck --workspace=@packscout/database",
    "typecheck:services": "npm run typecheck --workspace=@packscout/services",
    "typecheck:worker": "npm run typecheck --workspace=@packscout/worker",
    "typecheck:convex": "tsc -p convex/tsconfig.json --noEmit",
    "typecheck:frontend": "npm run typecheck --workspace=@packscout/frontend",
    "typecheck:admin": "npm run typecheck --workspace=@packscout/admin",
    "test": "npm run test:contracts && npm run test:database && npm run test:services && npm run test:worker && npm run test:convex && npm run test:frontend && npm run test:admin && npm run test:ops-panel",
    "test:ops-panel": "npm run test --workspace=@packscout/ops-panel",
    "test:contracts": "npm run test --workspace=@packscout/contracts",
    "test:database": "npm run test --workspace=@packscout/database",
    "test:services": "npm run test --workspace=@packscout/services",
    "test:worker": "npm run test --workspace=@packscout/worker",
    "test:convex": "vitest run",
    "test:frontend": "npm run test --workspace=@packscout/frontend",
    "test:admin": "npm run test --workspace=@packscout/admin",
    "test:tooling": "node scripts/run-tests.mjs tooling",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:scripts": "node scripts/check-scripts.mjs",
    "check:framework": "npm run check:boundaries && npm run check:dependencies && npm run check:docs && npm run check:scripts && npm run check:prisma-only",
    "capture:dataforest-evidence:local": "node scripts/local/capture-dataforest-evidence.mjs",
    "measure:provider-source-page-memory:local": "node --expose-gc --import tsx scripts/local/measure-provider-source-page-memory.mts",
    "generate:provider-source-capacity-artifact:local": "node --import tsx scripts/local/generate-provider-source-capacity-artifact.mts",
    "preflight:provider-source-backfill:local": "node --import tsx scripts/local/check-provider-source-backfill-capacity.mts",
    "init:provider-source-task010-environment:local": "node scripts/local/initialize-provider-source-task010-environment.mjs",
    "inspect:provider-source-task010-target:local": "node --import tsx scripts/local/inspect-provider-source-task010-target.mts",
    "migrate:provider-source-task010-target:local": "node --import tsx scripts/local/migrate-provider-source-task010-target.mts",
    "bootstrap:provider-source-task010-target:local": "node --import tsx scripts/local/bootstrap-provider-source-task010-target.mts",
    "bootstrap:clutchpacks-v3-canary:local": "node --import tsx scripts/local/bootstrap-clutchpacks-v3-canary-tenant.mts",
    "advance:clutchpacks-v3-canary:local": "node --import tsx scripts/local/advance-clutchpacks-v3-canary.mts",
    "generate:catalog-candidate:clutchpacks:local": "node --import tsx scripts/local/generate-clutchpacks-v3-public-catalog-candidate.mts",
    "approve:catalog-refresh:clutchpacks:local": "node --import tsx scripts/local/approve-clutchpacks-v3-public-catalog-refresh.mts",
    "promote:data-release-v3:clutchpacks:local": "node --import tsx scripts/local/promote-clutchpacks-data-release-v3.mjs",
    "start:provider-source-task010-configuration:local": "PACKSCOUT_TASK010_SUPERVISOR_PHASE=configuration node --import tsx scripts/local/start-provider-source-task010-supervisor.mts",
    "start:provider-source-task010-backfill:local": "PACKSCOUT_TASK010_SUPERVISOR_PHASE=backfill node --import tsx scripts/local/start-provider-source-task010-supervisor.mts",
    "start:provider-source-task010-admin:local": "node --import tsx scripts/local/start-provider-source-task010-admin.mts",
    "reconcile:provider-source-task010:local": "node --import tsx scripts/local/reconcile-provider-source-task010-backfill.mts",
    "fetch:gacha-top-cards": "node scripts/fetch-gacha-top-cards.mjs",
    "scan:framework-standards": "node scripts/scan-framework-standards.mjs",
    "scan:framework-standards:baseline": "node scripts/scan-framework-standards.mjs --summary --write-baseline docs/framework-standards-scan-baseline.json",
    "scan:framework-standards:ratchet": "node scripts/scan-framework-standards.mjs --summary --baseline docs/framework-standards-scan-baseline.json --fail-on-new",
    "measure:gate": "node scripts/measure-gate.mjs --baseline docs/gate-timing-baseline.json",
    "measure:gate:baseline": "node scripts/measure-gate.mjs --out docs/gate-timing-baseline.json",
    "verify:framework": "npm run check:framework && npm run check:prisma && npm run scan:framework-standards:ratchet && npm run lint && npm run typecheck && npm run test && npm run test:tooling && npm run build",
    "check:prisma": "npm run db:prisma:validate && npm run db:prisma:generate && npm run test:prisma-schema && npm run test:prisma-lifecycle && npm run test:prisma-setup",
    "check:prisma-only": "node scripts/check-prisma-only.mjs",
    "db:prisma:validate": "npm run prisma:validate --workspace=@packscout/database",
    "db:prisma:validate:central": "npm run prisma:validate:central --workspace=@packscout/database",
    "db:prisma:validate:provider": "npm run prisma:validate:provider --workspace=@packscout/database",
    "db:prisma:generate": "npm run prisma:generate --workspace=@packscout/database",
    "db:prisma:migrate:deploy": "npm run prisma:migrate:deploy --workspace=@packscout/database",
    "db:seed:local": "node scripts/local/seed-postgres-development-data.mjs",
    "db:reset:local": "node scripts/local/reset-postgres-development-database.mjs",
    "db:bootstrap-first-admin:local": "node --import tsx scripts/local/bootstrap-postgres-development-first-admin.mts",
    "db:inspect:clutchpacks-review:local": "NODE_ENV=development PACKSCOUT_LOCAL_REVIEW_CLUSTER_ACTION=inspect PACKSCOUT_LOCAL_REVIEW_CLUSTER_TARGET=all node --import tsx scripts/local/provision-clutchpacks-review-databases.mts",
    "db:provision:clutchpacks-review:local": "NODE_ENV=development PACKSCOUT_LOCAL_REVIEW_CLUSTER_ACTION=provision PACKSCOUT_LOCAL_REVIEW_CLUSTER_TARGET=all node --import tsx scripts/local/provision-clutchpacks-review-databases.mts",
    "db:inspect:packscout-control:local": "NODE_ENV=development PACKSCOUT_LOCAL_REVIEW_CLUSTER_ACTION=inspect PACKSCOUT_LOCAL_REVIEW_CLUSTER_TARGET=control node --import tsx scripts/local/provision-clutchpacks-review-databases.mts",
    "db:start:packscout-control:local": "NODE_ENV=development PACKSCOUT_LOCAL_REVIEW_CLUSTER_ACTION=start PACKSCOUT_LOCAL_REVIEW_CLUSTER_TARGET=control node --import tsx scripts/local/provision-clutchpacks-review-databases.mts",
    "db:stop:packscout-control:local": "NODE_ENV=development PACKSCOUT_LOCAL_REVIEW_CLUSTER_ACTION=stop PACKSCOUT_LOCAL_REVIEW_CLUSTER_TARGET=control node --import tsx scripts/local/provision-clutchpacks-review-databases.mts",
    "db:inspect:packscout-clutchpacks:local": "NODE_ENV=development PACKSCOUT_LOCAL_REVIEW_CLUSTER_ACTION=inspect PACKSCOUT_LOCAL_REVIEW_CLUSTER_TARGET=clutchpacks node --import tsx scripts/local/provision-clutchpacks-review-databases.mts",
    "db:start:packscout-clutchpacks:local": "NODE_ENV=development PACKSCOUT_LOCAL_REVIEW_CLUSTER_ACTION=start PACKSCOUT_LOCAL_REVIEW_CLUSTER_TARGET=clutchpacks node --import tsx scripts/local/provision-clutchpacks-review-databases.mts",
    "db:stop:packscout-clutchpacks:local": "NODE_ENV=development PACKSCOUT_LOCAL_REVIEW_CLUSTER_ACTION=stop PACKSCOUT_LOCAL_REVIEW_CLUSTER_TARGET=clutchpacks node --import tsx scripts/local/provision-clutchpacks-review-databases.mts",
    "db:inspect:additional-providers-review:local": "NODE_ENV=development PACKSCOUT_LOCAL_PROVIDER_REVIEW_CLUSTER_ACTION=inspect PACKSCOUT_LOCAL_PROVIDER_REVIEW_CLUSTER_TARGET=all node --import tsx scripts/local/provision-provider-review-databases.mts",
    "db:provision:additional-providers-review:local": "NODE_ENV=development PACKSCOUT_LOCAL_PROVIDER_REVIEW_CLUSTER_ACTION=provision PACKSCOUT_LOCAL_PROVIDER_REVIEW_CLUSTER_TARGET=all node --import tsx scripts/local/provision-provider-review-databases.mts",
    "db:inspect:packscout-courtyard:local": "NODE_ENV=development PACKSCOUT_LOCAL_PROVIDER_REVIEW_CLUSTER_ACTION=inspect PACKSCOUT_LOCAL_PROVIDER_REVIEW_CLUSTER_TARGET=courtyard node --import tsx scripts/local/provision-provider-review-databases.mts",
    "db:start:packscout-courtyard:local": "NODE_ENV=development PACKSCOUT_LOCAL_PROVIDER_REVIEW_CLUSTER_ACTION=start PACKSCOUT_LOCAL_PROVIDER_REVIEW_CLUSTER_TARGET=courtyard node --import tsx scripts/local/provision-provider-review-databases.mts",
    "db:stop:packscout-courtyard:local": "NODE_ENV=development PACKSCOUT_LOCAL_PROVIDER_REVIEW_CLUSTER_ACTION=stop PACKSCOUT_LOCAL_PROVIDER_REVIEW_CLUSTER_TARGET=courtyard node --import tsx scripts/local/provision-provider-review-databases.mts",
    "db:inspect:packscout-collector-crypt:local": "NODE_ENV=development PACKSCOUT_LOCAL_PROVIDER_REVIEW_CLUSTER_ACTION=inspect PACKSCOUT_LOCAL_PROVIDER_REVIEW_CLUSTER_TARGET=collector_crypt node --import tsx scripts/local/provision-provider-review-databases.mts",
    "db:start:packscout-collector-crypt:local": "NODE_ENV=development PACKSCOUT_LOCAL_PROVIDER_REVIEW_CLUSTER_ACTION=start PACKSCOUT_LOCAL_PROVIDER_REVIEW_CLUSTER_TARGET=collector_crypt node --import tsx scripts/local/provision-provider-review-databases.mts",
    "db:stop:packscout-collector-crypt:local": "NODE_ENV=development PACKSCOUT_LOCAL_PROVIDER_REVIEW_CLUSTER_ACTION=stop PACKSCOUT_LOCAL_PROVIDER_REVIEW_CLUSTER_TARGET=collector_crypt node --import tsx scripts/local/provision-provider-review-databases.mts",
    "db:inspect:packscout-phygitals:local": "NODE_ENV=development PACKSCOUT_LOCAL_PROVIDER_REVIEW_CLUSTER_ACTION=inspect PACKSCOUT_LOCAL_PROVIDER_REVIEW_CLUSTER_TARGET=phygitals node --import tsx scripts/local/provision-provider-review-databases.mts",
    "db:start:packscout-phygitals:local": "NODE_ENV=development PACKSCOUT_LOCAL_PROVIDER_REVIEW_CLUSTER_ACTION=start PACKSCOUT_LOCAL_PROVIDER_REVIEW_CLUSTER_TARGET=phygitals node --import tsx scripts/local/provision-provider-review-databases.mts",
    "db:stop:packscout-phygitals:local": "NODE_ENV=development PACKSCOUT_LOCAL_PROVIDER_REVIEW_CLUSTER_ACTION=stop PACKSCOUT_LOCAL_PROVIDER_REVIEW_CLUSTER_TARGET=phygitals node --import tsx scripts/local/provision-provider-review-databases.mts",
    "activate:dataforrest-source:clutchpacks:local": "NODE_ENV=development node --import tsx scripts/local/activate-clutchpacks-dataforrest-source.mts",
    "activate:dataforrest-source:collector-crypt:local": "NODE_ENV=development node --import tsx scripts/local/activate-collector-crypt-dataforrest-source.mts",
    "prepare:dataforrest-replay:clutchpacks:local": "NODE_ENV=development node --import tsx scripts/local/prepare-clutchpacks-dataforrest-replay.mts",
    "db:prisma:generate:central": "npm run prisma:generate:central --workspace=@packscout/database",
    "db:prisma:generate:provider": "npm run prisma:generate:provider --workspace=@packscout/database",
    "db:prisma:migrate:deploy:central": "npm run prisma:migrate:deploy:central --workspace=@packscout/database",
    "db:prisma:migrate:deploy:provider": "npm run prisma:migrate:deploy:provider --workspace=@packscout/database",
    "test:prisma-schema": "npm run test:prisma-schema --workspace=@packscout/database",
    "test:prisma-lifecycle": "npm run test:prisma-lifecycle --workspace=@packscout/database",
    "test:prisma-setup": "npm run test:prisma-setup --workspace=@packscout/database",
    "convex:ai-files": "convex ai-files status",
    "convex:codegen": "convex codegen --typecheck enable",
    "approve:catalog-configuration:clutchpacks:preproduction": "node --import tsx scripts/preproduction/approve-clutchpacks-public-catalog-configuration.mjs",
    "catalog:canary:clutchpacks:preproduction": "node --import tsx scripts/preproduction/run-clutchpacks-catalog-canary.mjs",
    "cutover:preflight:fresh-convex:preproduction": "node scripts/preproduction/verify-fresh-convex-target.mjs",
    "cutover:reset:preproduction": "node scripts/preproduction/reset-postgres-convex-promotion-cutover.mjs",
    "cutover:certify:preproduction": "node scripts/preproduction/certify-provider-manifest-readiness.mjs",
    "seed:mock-data-release:local": "node scripts/local/seed-convex-mock-data-release.mjs",
    "simulate:mock-heat:local": "node --import tsx scripts/local/simulate-convex-repack-heat.mjs",
    "dev:frontend:mock:local": "node scripts/local/start-frontend-with-convex-mock.mjs",
    "dev:frontend:mock-heat:local": "node --import tsx scripts/local/start-frontend-with-convex-mock-heat.mjs",
    "services:restart:local": "./scripts/local/restart.sh",
    "workspace:update:main:local": "./scripts/local/update-main.sh",
    "start:frontend": "npm run start --workspace=@packscout/frontend",
    "start:admin": "npm run start --workspace=@packscout/admin",
    "start:worker:local": "npm run start:local --workspace=@packscout/worker",
    "start:source-supervisor:local": "npm run start:source-supervisor:local --workspace=@packscout/worker",
    "start:worker:production": "npm run start:production --workspace=@packscout/worker",
    "start:admin:embedded:local": "tsx scripts/local/start-admin-embedded.ts",
    "start:admin-operations-fixture:local": "node --import tsx scripts/local/start-admin-operations-browser-fixture.mts"
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0",
    "concurrently": "^9.1.2",
    "convex": "1.43.0",
    "convex-test": "0.0.55",
    "tsx": "^4.19.2",
    "vitest": "4.1.10"
  }
}
