{
  "name": "packscout",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22",
    "npm": ">=10.9.0 <11"
  },
  "workspaces": [
    "apps/frontend",
    "apps/admin",
    "apps/worker",
    "packages/contracts",
    "packages/database",
    "packages/services"
  ],
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "scripts": {
    "postinstall": "npm run db:prisma:generate",
    "dev": "npm run dev:frontend",
    "dev:frontend": "npm run dev --workspace=@packscout/frontend",
    "dev:admin": "npm run dev --workspace=@packscout/admin",
    "dev:worker": "npm run dev --workspace=@packscout/worker",
    "dev:all": "concurrently --names 'frontend,admin' --prefix-colors 'cyan,yellow' 'npm run dev:frontend' 'npm run dev:admin'",
    "build": "npm run build:contracts && npm run build:database && npm run build:services && npm run build:worker && npm run build:frontend && npm run build:admin",
    "build:contracts": "npm run build --workspace=@packscout/contracts",
    "build:database": "npm run build --workspace=@packscout/database",
    "build:services": "npm run build --workspace=@packscout/services",
    "build:worker": "npm run build --workspace=@packscout/worker",
    "build:frontend": "npm run build --workspace=@packscout/frontend",
    "build:admin": "npm run build --workspace=@packscout/admin",
    "lint": "npm run lint:contracts && npm run lint:database && npm run lint:services && npm run lint:worker && npm run lint:frontend && npm run lint:admin",
    "lint:contracts": "npm run lint --workspace=@packscout/contracts",
    "lint:database": "npm run lint --workspace=@packscout/database",
    "lint:services": "npm run lint --workspace=@packscout/services",
    "lint:worker": "npm run lint --workspace=@packscout/worker",
    "lint:frontend": "npm run lint --workspace=@packscout/frontend",
    "lint:admin": "npm run lint --workspace=@packscout/admin",
    "typecheck": "npm run typecheck:contracts && npm run typecheck:database && npm run typecheck:services && npm run typecheck:worker && npm run typecheck:convex && npm run typecheck:frontend && npm run typecheck:admin",
    "typecheck:contracts": "npm run typecheck --workspace=@packscout/contracts",
    "typecheck:database": "npm run typecheck --workspace=@packscout/database",
    "typecheck:services": "npm run typecheck --workspace=@packscout/services",
    "typecheck:worker": "npm run typecheck --workspace=@packscout/worker",
    "typecheck:convex": "tsc -p convex/tsconfig.json --noEmit --incremental false",
    "typecheck:frontend": "npm run typecheck --workspace=@packscout/frontend",
    "typecheck:admin": "npm run typecheck --workspace=@packscout/admin",
    "test": "npm run test:contracts && npm run test:database && npm run test:services && npm run test:worker && npm run test:convex && npm run test:frontend && npm run test:admin && npm run test:root",
    "test:contracts": "npm run test --workspace=@packscout/contracts",
    "test:database": "npm run test --workspace=@packscout/database",
    "test:services": "npm run test --workspace=@packscout/services",
    "test:worker": "npm run test --workspace=@packscout/worker",
    "test:convex": "vitest run",
    "test:frontend": "npm run test --workspace=@packscout/frontend",
    "test:admin": "npm run test --workspace=@packscout/admin",
    "test:root": "node scripts/run-tests.mjs root",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:scripts": "node scripts/check-scripts.mjs",
    "check:framework": "npm run check:boundaries && npm run check:dependencies && npm run check:docs && npm run check:scripts && npm run check:prisma-only && npm run check:provider-v2-only",
    "fetch:gacha-top-cards": "node scripts/fetch-gacha-top-cards.mjs",
    "scan:framework-standards": "node scripts/scan-framework-standards.mjs",
    "scan:framework-standards:baseline": "node scripts/scan-framework-standards.mjs --summary --write-baseline docs/framework-standards-scan-baseline.json",
    "scan:framework-standards:ratchet": "node scripts/scan-framework-standards.mjs --summary --baseline docs/framework-standards-scan-baseline.json --fail-on-new",
    "verify:framework": "npm run check:framework && npm run check:prisma && npm run scan:framework-standards:ratchet && npm run lint && npm run typecheck && npm run test && npm run build",
    "check:prisma": "npm run db:prisma:validate && npm run db:prisma:generate && npm run test:prisma-schema && npm run test:prisma-lifecycle && npm run test:prisma-setup",
    "check:prisma-only": "node scripts/check-prisma-only.mjs",
    "check:provider-v2-only": "node scripts/check-provider-v2-only.mjs",
    "db:prisma:validate": "npm run prisma:validate --workspace=@packscout/database",
    "db:prisma:generate": "npm run prisma:generate --workspace=@packscout/database",
    "db:prisma:migrate:deploy": "npm run prisma:migrate:deploy --workspace=@packscout/database",
    "test:prisma-schema": "npm run test:prisma-schema --workspace=@packscout/database",
    "test:prisma-lifecycle": "npm run test:prisma-lifecycle --workspace=@packscout/database",
    "test:prisma-setup": "npm run test:prisma-setup --workspace=@packscout/database",
    "convex:ai-files": "convex ai-files status",
    "convex:codegen": "convex codegen --typecheck enable",
    "seed:mock-data-release:local": "node scripts/local/seed-convex-mock-data-release.mjs",
    "simulate:mock-heat:local": "node --import tsx scripts/local/simulate-convex-repack-heat.mjs",
    "dev:frontend:mock:local": "node scripts/local/start-frontend-with-convex-mock.mjs",
    "dev:frontend:mock-heat:local": "node --import tsx scripts/local/start-frontend-with-convex-mock-heat.mjs",
    "services:restart:local": "./scripts/local/restart.sh",
    "workspace:update:main:local": "./scripts/local/update-main.sh",
    "start:frontend": "npm run start --workspace=@packscout/frontend",
    "start:admin": "npm run start --workspace=@packscout/admin",
    "start:worker:local": "npm run start:local --workspace=@packscout/worker",
    "start:worker:production": "npm run start:production --workspace=@packscout/worker",
    "start:admin:embedded:local": "tsx scripts/local/start-admin-embedded.ts",
    "import:provider-archive-v2:local": "node --import tsx scripts/local/import-provider-archive-v2.ts"
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0",
    "concurrently": "^9.1.2",
    "convex": "1.43.0",
    "convex-test": "0.0.55",
    "tsx": "^4.19.2",
    "vitest": "4.1.10"
  }
}
