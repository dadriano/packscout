{
  "name": "packscout",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22",
    "npm": ">=10.9.0 <11"
  },
  "workspaces": [
    "apps/frontend",
    "apps/admin"
  ],
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:frontend": "npm run dev --workspace=@packscout/frontend",
    "dev:admin": "npm run dev --workspace=@packscout/admin",
    "dev:all": "concurrently --names 'frontend,admin' --prefix-colors 'cyan,yellow' 'npm run dev:frontend' 'npm run dev:admin'",
    "build": "npm run build:frontend && npm run build:admin",
    "build:frontend": "npm run build --workspace=@packscout/frontend",
    "build:admin": "npm run build --workspace=@packscout/admin",
    "lint": "npm run lint:frontend && npm run lint:admin",
    "lint:frontend": "npm run lint --workspace=@packscout/frontend",
    "lint:admin": "npm run lint --workspace=@packscout/admin",
    "typecheck": "npm run typecheck:frontend && npm run typecheck:admin",
    "typecheck:frontend": "npm run typecheck --workspace=@packscout/frontend",
    "typecheck:admin": "npm run typecheck --workspace=@packscout/admin",
    "test": "npm run test:frontend && npm run test:admin && npm run test:root",
    "test:frontend": "npm run test --workspace=@packscout/frontend",
    "test:admin": "npm run test --workspace=@packscout/admin",
    "test:root": "node scripts/run-tests.mjs root",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:scripts": "node scripts/check-scripts.mjs",
    "check:framework": "npm run check:boundaries && npm run check:dependencies && npm run check:docs && npm run check:scripts",
    "fetch:gacha-top-cards": "node scripts/fetch-gacha-top-cards.mjs",
    "scan:framework-standards": "node scripts/scan-framework-standards.mjs",
    "scan:framework-standards:baseline": "node scripts/scan-framework-standards.mjs --summary --write-baseline docs/framework-standards-scan-baseline.json",
    "scan:framework-standards:ratchet": "node scripts/scan-framework-standards.mjs --summary --baseline docs/framework-standards-scan-baseline.json --fail-on-new",
    "verify:framework": "npm run check:framework && npm run scan:framework-standards:ratchet && npm run lint && npm run typecheck && npm run test && npm run build",
    "start:frontend": "npm run start --workspace=@packscout/frontend",
    "start:admin": "npm run start --workspace=@packscout/admin"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2"
  }
}
