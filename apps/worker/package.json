{
  "name": "@packscout/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "start:local": "NODE_ENV=development tsx src/index.ts",
    "start:source-supervisor:local": "NODE_ENV=development tsx src/source-supervisor-local.ts",
    "run:clutchpacks-import-once:local": "NODE_ENV=development tsx src/clutchpacks-manual-import-local.ts",
    "start:production": "NODE_ENV=production tsx src/index.ts",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@packscout/database": "0.0.0",
    "@packscout/services": "0.0.0",
    "dotenv": "^16.4.5",
    "pg": "^8.16.3",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20",
    "@types/pg": "^8.15.6",
    "eslint": "^9",
    "globals": "^14.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.65.0"
  }
}
