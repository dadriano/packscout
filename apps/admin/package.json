{
  "name": "@packscout/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "build:vercel": "npm run build:vercel:server && tsc -b && vite build --mode vercel",
    "build:vercel:server": "esbuild server/vercel-entry.ts --bundle --platform=node --format=esm --target=node22 --external:@prisma/client --external:argon2 --external:express --external:pg --alias:@packscout/contracts=../../packages/contracts/src/index.ts --alias:@packscout/database=../../packages/database/src/index.ts --alias:@packscout/services=../../packages/services/src/index.ts --outfile=dist/server.bundle.mjs",
    "start": "NODE_ENV=production tsx server/index.ts",
    "preview": "vite build && NODE_ENV=production tsx server/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "node ../../scripts/run-tests.mjs admin"
  },
  "dependencies": {
    "@packscout/contracts": "0.0.0",
    "@packscout/database": "0.0.0",
    "@packscout/services": "0.0.0",
    "argon2": "^0.44.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.12",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^14.0.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.3"
  }
}
