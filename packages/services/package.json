{
  "name": "@packscout/services",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./repack-heat-calculator": "./src/repack-heat-calculator.ts"
  },
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:unit && npm run test:volume",
    "test:unit": "node --import tsx --test --test-skip-pattern='^protocol-maximum local catalog preparation stays bounded and completes within one minute$' 'src/**/*.test.ts'",
    "test:volume": "node --import tsx --test src/catalog-release-volume.test.ts"
  },
  "dependencies": {
    "@packscout/contracts": "0.0.0"
  },
  "devDependencies": {
    "@packscout/database": "0.0.0",
    "@types/node": "^20",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
