  @@unique([organization_id, configuration_key], map: "approved_public_catalog_configurations_key_unique")
  @@unique([organization_id, revision], map: "approved_public_catalog_configurations_revision_unique")
  @@unique([organization_id, configuration_hash], map: "approved_public_catalog_configurations_hash_unique")
  @@unique([organization_id, configuration_key, public_change_sequence], map: "approved_public_catalog_configurations_mapping_source_unique")
  @@index([organization_id, public_change_sequence], map: "approved_public_catalog_configurations_change_idx")
}

