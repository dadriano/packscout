  canonical_entities_canonical_revisions_entity_id_organization_idTocanonical_entities                                                 canonical_entities                     @relation("canonical_revisions_entity_id_organization_idTocanonical_entities", fields: [entity_id, organization_id], references: [id, organization_id], onUpdate: NoAction, map: "canonical_revisions_entity_tenant_fk")
  organizations                                                                                                                        organizations                          @relation(fields: [organization_id], references: [id], onUpdate: NoAction, map: "canonical_revisions_organization_id_organizations_id_fk")
  source_records_canonical_revisions_source_record_idTosource_records                                                                  source_records?                        @relation("canonical_revisions_source_record_idTosource_records", fields: [source_record_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "canonical_revisions_source_record_id_source_records_id_fk")
  source_records_canonical_revisions_source_record_id_organization_idTosource_records                                                  source_records?                        @relation("canonical_revisions_source_record_id_organization_idTosource_records", fields: [source_record_id, organization_id], references: [id, organization_id], onDelete: Restrict, onUpdate: NoAction, map: "canonical_revisions_source_tenant_fk")
  source_semantic_observations                                                                                                         source_semantic_observations?          @relation("canonical_revisions_origin_semantic_observation", fields: [origin_semantic_observation_id, organization_id], references: [id, organization_id], onDelete: Restrict, onUpdate: NoAction, map: "canonical_revisions_origin_semantic_observation_fk")
  estimated_ev_recomputation_requests_origin                                                                                           estimated_ev_recomputation_requests?   @relation("canonical_revisions_origin_ev_recomputation", fields: [origin_ev_recomputation_request_id, organization_id], references: [id, organization_id], onDelete: Restrict, onUpdate: NoAction, map: "canonical_revisions_origin_ev_recomputation_fk")
  estimated_ev_recomputation_requests_estimated_ev_recomputation_requests_calculation_revision_id_organization_idTocanonical_revisions estimated_ev_recomputation_requests[]  @relation("estimated_ev_recomputation_requests_calculation_revision_id_organization_idTocanonical_revisions")
  estimated_ev_recomputation_requests_estimated_ev_recomputation_requests_ev_input_revision_id_organization_idTocanonical_revisions    estimated_ev_recomputation_requests[]  @relation("estimated_ev_recomputation_requests_ev_input_revision_id_organization_idTocanonical_revisions")
  estimated_ev_recomputation_requests_estimated_ev_recomputation_requests_pack_revision_id_organization_idTocanonical_revisions        estimated_ev_recomputation_requests[]  @relation("estimated_ev_recomputation_requests_pack_revision_id_organization_idTocanonical_revisions")
  estimated_ev_recomputation_requests_estimated_ev_recomputation_requests_calculation_revision_idTocanonical_revisions                 estimated_ev_recomputation_requests[]  @relation("estimated_ev_recomputation_requests_calculation_revision_idTocanonical_revisions")
  estimated_ev_recomputation_requests_estimated_ev_recomputation_requests_ev_input_revision_idTocanonical_revisions                    estimated_ev_recomputation_requests[]  @relation("estimated_ev_recomputation_requests_ev_input_revision_idTocanonical_revisions")
  estimated_ev_recomputation_requests_estimated_ev_recomputation_requests_pack_revision_idTocanonical_revisions                        estimated_ev_recomputation_requests[]  @relation("estimated_ev_recomputation_requests_pack_revision_idTocanonical_revisions")
  source_record_projection_revisions_source_record_projection_revisions_canonical_revision_idTocanonical_revisions                     source_record_projection_revisions[]   @relation("source_record_projection_revisions_canonical_revision_idTocanonical_revisions")
  source_record_projection_revisions_source_record_projection_revisions_canonical_revision_id_organization_idTocanonical_revisions     source_record_projection_revisions[]   @relation("source_record_projection_revisions_canonical_revision_id_organization_idTocanonical_revisions")
