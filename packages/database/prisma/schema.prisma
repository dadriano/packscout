generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("PACKSCOUT_DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model admin_alerts {
  id                                                                                  String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id                                                                     String                 @db.Uuid
  latest_event_id                                                                     String                 @db.Uuid
  kind                                                                                operational_event_kind
  severity                                                                            operational_severity
  state                                                                               admin_alert_state      @default(active)
  dedupe_key                                                                          String
  recovery_key                                                                        String
  title                                                                               String
  summary                                                                             String
  provider_id                                                                         String?                @db.Uuid
  run_id                                                                              String?                @db.Uuid
  quarantine_id                                                                       String?                @db.Uuid
  first_seen_at                                                                       DateTime               @db.Timestamptz(6)
  last_seen_at                                                                        DateTime               @db.Timestamptz(6)
  occurrence_count                                                                    Int                    @default(1)
  reopened_count                                                                      Int                    @default(0)
  acknowledged_by_actor_key                                                           String?
  acknowledged_at                                                                     DateTime?              @db.Timestamptz(6)
  resolved_by_actor_key                                                               String?
  resolved_at                                                                         DateTime?              @db.Timestamptz(6)
  operational_events_admin_alerts_latest_event_idTooperational_events                 operational_events     @relation("admin_alerts_latest_event_idTooperational_events", fields: [latest_event_id], references: [id], onUpdate: NoAction, map: "admin_alerts_latest_event_id_operational_events_id_fk")
  operational_events_admin_alerts_latest_event_id_organization_idTooperational_events operational_events     @relation("admin_alerts_latest_event_id_organization_idTooperational_events", fields: [latest_event_id, organization_id], references: [id, organization_id], onUpdate: NoAction, map: "admin_alerts_latest_event_tenant_fk")
  organizations                                                                       organizations          @relation(fields: [organization_id], references: [id], onUpdate: NoAction, map: "admin_alerts_organization_id_organizations_id_fk")
  provider_sources_admin_alerts_provider_idToprovider_sources                         provider_sources?      @relation("admin_alerts_provider_idToprovider_sources", fields: [provider_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "admin_alerts_provider_id_provider_sources_id_fk")
  provider_sources_admin_alerts_provider_id_organization_idToprovider_sources         provider_sources?      @relation("admin_alerts_provider_id_organization_idToprovider_sources", fields: [provider_id, organization_id], references: [id, organization_id], onUpdate: NoAction, map: "admin_alerts_provider_tenant_fk")
  quarantine_records_admin_alerts_quarantine_idToquarantine_records                   quarantine_records?    @relation("admin_alerts_quarantine_idToquarantine_records", fields: [quarantine_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "admin_alerts_quarantine_id_quarantine_records_id_fk")
  quarantine_records_admin_alerts_quarantine_id_organization_idToquarantine_records   quarantine_records?    @relation("admin_alerts_quarantine_id_organization_idToquarantine_records", fields: [quarantine_id, organization_id], references: [id, organization_id], onUpdate: NoAction, map: "admin_alerts_quarantine_tenant_fk")
  import_runs_admin_alerts_run_idToimport_runs                                        import_runs?           @relation("admin_alerts_run_idToimport_runs", fields: [run_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "admin_alerts_run_id_import_runs_id_fk")
  import_runs_admin_alerts_run_id_organization_id_provider_idToimport_runs            import_runs?           @relation("admin_alerts_run_id_organization_id_provider_idToimport_runs", fields: [run_id, organization_id, provider_id], references: [id, organization_id, provider_id], onUpdate: NoAction, map: "admin_alerts_run_tenant_fk")

  @@unique([organization_id, dedupe_key], map: "admin_alerts_organization_dedupe_unique")
  @@index([organization_id, state, last_seen_at], map: "admin_alerts_organization_state_seen_idx")
}

model audit_events {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String?        @db.Uuid
  actor_key       String
  action          String
  subject_type    String
  subject_id      String?        @db.Uuid
  outcome         audit_outcome
  metadata_json   Json           @default("{}")
  occurred_at     DateTime       @default(now()) @db.Timestamptz(6)
  organizations   organizations? @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "audit_events_organization_id_organizations_id_fk")

  @@unique([id, organization_id], map: "audit_events_tenant_unique")
  @@index([organization_id, occurred_at], map: "audit_events_organization_occurred_idx")
}

/// Immutable, causally ordered approval for one public catalog policy.
model approved_public_catalog_configurations {
  id                              String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id                 String                            @db.Uuid
  configuration_key               String
  revision                        Int
  configuration_json              Json
  configuration_hash              String
  approved_at                     DateTime                          @db.Timestamptz(6)
  public_change_sequence          BigInt
  created_at                      DateTime                          @default(now()) @db.Timestamptz(6)
  organizations                   organizations                     @relation(fields: [organization_id], references: [id], onUpdate: NoAction, map: "approved_public_catalog_configurations_organization_fk")
  public_change_causes            public_change_causes              @relation(fields: [organization_id, public_change_sequence], references: [organization_id, sequence], onUpdate: NoAction, map: "approved_public_catalog_configurations_public_change_fk")
  public_repack_identity_mappings public_repack_identity_mappings[]

  @@unique([organization_id, configuration_key], map: "approved_public_catalog_configurations_key_unique")
  @@unique([organization_id, revision], map: "approved_public_catalog_configurations_revision_unique")
  @@unique([organization_id, configuration_hash], map: "approved_public_catalog_configurations_hash_unique")
  @@unique([organization_id, configuration_key, public_change_sequence], map: "approved_public_catalog_configurations_mapping_source_unique")
  @@index([organization_id, public_change_sequence], map: "approved_public_catalog_configurations_change_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model auth_rate_limits {
  bucket_key        String    @id
  window_started_at DateTime  @db.Timestamptz(6)
  attempt_count     Int       @default(0)
  blocked_until     DateTime? @db.Timestamptz(6)
  updated_at        DateTime  @default(now()) @db.Timestamptz(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model canonical_entities {
  id                                                                                                   String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id                                                                                      String                    @db.Uuid
  platform_key                                                                                         String
  record_kind                                                                                          canonical_record_kind
  external_id                                                                                          String
  current_revision_id                                                                                  String?                   @db.Uuid
  created_at                                                                                           DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at                                                                                           DateTime                  @default(now()) @db.Timestamptz(6)
  canonical_revisions_canonical_entities_current_revision_idTocanonical_revisions                      canonical_revisions?      @relation("canonical_entities_current_revision_idTocanonical_revisions", fields: [current_revision_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "canonical_entities_current_revision_id_canonical_revisions_id_f")
  organizations                                                                                        organizations             @relation(fields: [organization_id], references: [id], onUpdate: NoAction, map: "canonical_entities_organization_id_organizations_id_fk")
  canonical_relationships_canonical_relationships_source_entity_idTocanonical_entities                 canonical_relationships[] @relation("canonical_relationships_source_entity_idTocanonical_entities")
  canonical_relationships_canonical_relationships_source_entity_id_organization_idTocanonical_entities canonical_relationships[] @relation("canonical_relationships_source_entity_id_organization_idTocanonical_entities")
  canonical_relationships_canonical_relationships_target_entity_idTocanonical_entities                 canonical_relationships[] @relation("canonical_relationships_target_entity_idTocanonical_entities")
  canonical_relationships_canonical_relationships_target_entity_id_organization_idTocanonical_entities canonical_relationships[] @relation("canonical_relationships_target_entity_id_organization_idTocanonical_entities")
  canonical_revisions_canonical_revisions_entity_idTocanonical_entities                                canonical_revisions[]     @relation("canonical_revisions_entity_idTocanonical_entities")
  canonical_revisions_canonical_revisions_entity_id_organization_idTocanonical_entities                canonical_revisions[]     @relation("canonical_revisions_entity_id_organization_idTocanonical_entities")

  @@unique([id, organization_id], map: "canonical_entities_id_organization_unique")
  @@unique([organization_id, platform_key, record_kind, external_id], map: "canonical_entities_stable_identity_unique")
  @@index([current_revision_id], map: "canonical_entities_current_revision_idx")
  @@index([organization_id, platform_key, record_kind, updated_at(sort: Desc)], map: "canonical_entities_inspection_recency_idx")
}

model canonical_relationships {
  id                                                                                              String                                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id                                                                                 String                                 @db.Uuid
  source_entity_id                                                                                String                                 @db.Uuid
  relationship_kind                                                                               String
  target_platform_key                                                                             String
  target_record_kind                                                                              canonical_record_kind
  target_external_id                                                                              String?
  target_entity_id                                                                                String?                                @db.Uuid
  created_public_change_sequence                                                                  BigInt
  resolved_public_change_sequence                                                                 BigInt?
  created_at                                                                                      DateTime                               @default(now()) @db.Timestamptz(6)
  resolved_at                                                                                     DateTime?                              @db.Timestamptz(6)
  organizations                                                                                   organizations                          @relation(fields: [organization_id], references: [id], onUpdate: NoAction, map: "canonical_relationships_organization_id_organizations_id_fk")
  canonical_entities_canonical_relationships_source_entity_idTocanonical_entities                 canonical_entities                     @relation("canonical_relationships_source_entity_idTocanonical_entities", fields: [source_entity_id], references: [id], onUpdate: NoAction, map: "canonical_relationships_source_entity_id_canonical_entities_id_")
  canonical_entities_canonical_relationships_source_entity_id_organization_idTocanonical_entities canonical_entities                     @relation("canonical_relationships_source_entity_id_organization_idTocanonical_entities", fields: [source_entity_id, organization_id], references: [id, organization_id], onUpdate: NoAction, map: "canonical_relationships_source_tenant_fk")
  canonical_entities_canonical_relationships_target_entity_idTocanonical_entities                 canonical_entities?                    @relation("canonical_relationships_target_entity_idTocanonical_entities", fields: [target_entity_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "canonical_relationships_target_entity_id_canonical_entities_id_")
  canonical_entities_canonical_relationships_target_entity_id_organization_idTocanonical_entities canonical_entities?                    @relation("canonical_relationships_target_entity_id_organization_idTocanonical_entities", fields: [target_entity_id, organization_id], references: [id, organization_id], onUpdate: NoAction, map: "canonical_relationships_target_tenant_fk")
  public_change_causes_created                                                                    public_change_causes                   @relation("canonical_relationships_created_change", fields: [organization_id, created_public_change_sequence], references: [organization_id, sequence], onUpdate: NoAction, map: "canonical_relationships_created_change_fk")
  public_change_causes_resolved                                                                   public_change_causes?                  @relation("canonical_relationships_resolved_change", fields: [organization_id, resolved_public_change_sequence], references: [organization_id, sequence], onUpdate: NoAction, map: "canonical_relationships_resolved_change_fk")
  normalized_heat_observations                                                                    normalized_heat_observations[]         @relation("normalized_heat_observations_source_relationship")
  normalized_heat_observation_outcomes                                                            normalized_heat_observation_outcomes[] @relation("normalized_heat_observation_outcomes_source_relationship")

  @@unique([id, organization_id], map: "canonical_relationships_id_organization_unique")
  @@unique([id, organization_id, source_entity_id, relationship_kind, target_platform_key, target_record_kind, target_external_id], map: "canonical_relationships_confirmation_identity_unique")
  @@unique([source_entity_id, relationship_kind, target_platform_key, target_record_kind, target_external_id], map: "canonical_relationships_source_kind_target_unique")
  @@index([organization_id, target_platform_key, target_record_kind, target_external_id, resolved_at], map: "canonical_relationships_unresolved_lookup_idx")
}

/// One immutable, publicly ordered confirmation of a complete source-native
/// relationship declaration set for an exact semantic observation and source
/// revision. Database triggers verify all cross-ledger lineage and set parity.
model source_relationship_confirmation_sets {
  id                            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id               String   @db.Uuid
  provider_id                   String   @db.Uuid
  source_instance_id            String   @db.Uuid
  source_revision_id            String   @db.Uuid
  source_record_id              String   @db.Uuid
  semantic_observation_id       String   @db.Uuid
  source_entity_id              String   @db.Uuid
  source_canonical_revision_id  String   @db.Uuid
  source_canonical_content_hash String
  normalized_contract_version   String
  semantic_effective_at         DateTime @db.Timestamptz(6)
  declaration_hash              String
  relationship_count            Int      @db.SmallInt
  public_change_sequence        BigInt
  confirmation_mode             String
  confirmed_at                  DateTime @db.Timestamptz(6)
  created_at                    DateTime @default(now()) @db.Timestamptz(6)

  @@unique([id, organization_id], map: "source_relationship_confirmation_sets_tenant_unique")
  @@unique([organization_id, source_revision_id, semantic_observation_id], map: "source_relationship_confirmation_sets_semantic_unique")
  @@index([organization_id, source_revision_id, source_entity_id, public_change_sequence(sort: Desc)], map: "source_relationship_confirmation_sets_release_idx")
  @@index([organization_id, source_revision_id, source_entity_id, semantic_effective_at(sort: Desc), public_change_sequence(sort: Desc), id(sort: Desc)], map: "source_relationship_confirmation_sets_latest_semantic_idx")
  @@index([organization_id, source_entity_id, semantic_effective_at(sort: Desc), public_change_sequence(sort: Desc), id(sort: Desc)], map: "source_relationship_confirmation_sets_heat_latest_idx")
}

/// Exact physical relationship members of one confirmation set. The identity
/// columns intentionally duplicate the canonical edge key so an exact FK can
/// reject cross-target or cross-tenant adoption. The migration also defines a
/// partial effective-cursor index, which Prisma cannot represent.
model source_relationship_confirmations {
  confirmation_set_id                   String                @db.Uuid
  organization_id                       String                @db.Uuid
  canonical_relationship_id             String                @db.Uuid
  source_entity_id                      String                @db.Uuid
  relationship_kind                     String
  target_platform_key                   String
  target_record_kind                    canonical_record_kind
  target_external_id                    String
  confirmation_public_change_sequence   BigInt
  heat_effective_public_change_sequence BigInt?
  created_at                            DateTime              @default(now()) @db.Timestamptz(6)

  @@id([confirmation_set_id, organization_id, canonical_relationship_id], map: "source_relationship_confirmations_pkey")
  @@unique([confirmation_set_id, organization_id, relationship_kind], map: "source_relationship_confirmations_kind_unique")
  @@index([organization_id, confirmation_set_id, relationship_kind], map: "source_relationship_confirmations_set_kind_idx")
  @@index([organization_id, canonical_relationship_id, confirmation_set_id], map: "source_relationship_confirmations_relationship_idx")
  @@index([organization_id, target_platform_key, target_record_kind, target_external_id, confirmation_set_id], map: "source_relationship_confirmations_target_idx")
}

/// Frozen, source-revision-local proof that every pre-migration latest V1 pull
/// semantic set has been materialized into durable confirmation lineage.
model source_relationship_confirmation_backfills {
  organization_id                    String    @db.Uuid
  provider_id                        String    @db.Uuid
  source_instance_id                 String    @db.Uuid
  source_revision_id                 String    @db.Uuid
  phase                              String
  target_delivery_occurrence_id      BigInt
  retry_eligibility_cutoff_at        DateTime  @db.Timestamptz(6)
  processed_through_source_record_id String?   @db.Uuid
  target_semantic_set_count          BigInt
  confirmed_semantic_set_count       BigInt    @default(0)
  failure_code                       String?
  started_at                         DateTime? @db.Timestamptz(6)
  completed_at                       DateTime? @db.Timestamptz(6)
  created_at                         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at                         DateTime  @default(now()) @db.Timestamptz(6)

  @@id([organization_id, source_revision_id], map: "source_relationship_confirmation_backfills_pkey")
  @@index([phase, organization_id, source_revision_id], map: "source_relationship_confirmation_backfills_phase_idx")
}

