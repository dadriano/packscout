/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model estimated_ev_recomputation_requests {
  id                                                                                                                                             String                             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  request_key                                                                                                                                    String                             @unique(map: "estimated_ev_recomputation_request_key_unique")
  organization_id                                                                                                                                String                             @db.Uuid
  provider_id                                                                                                                                    String                             @db.Uuid
  configuration_revision_id                                                                                                                      String?                            @db.Uuid
  source_instance_id                                                                                                                             String?                            @db.Uuid
  source_revision_id                                                                                                                             String?                            @db.Uuid
  platform_key                                                                                                                                   String
  pack_external_id                                                                                                                               String
  ev_input_external_id                                                                                                                           String
  pack_revision_id                                                                                                                               String?                            @db.Uuid
  ev_input_revision_id                                                                                                                           String?                            @db.Uuid
  state                                                                                                                                          estimated_ev_recomputation_state   @default(queued)
  result_status                                                                                                                                  estimated_ev_recomputation_result?
  calculation_revision_id                                                                                                                        String?                            @db.Uuid
  attempt_count                                                                                                                                  Int                                @default(0)
  available_at                                                                                                                                   DateTime                           @default(now()) @db.Timestamptz(6)
