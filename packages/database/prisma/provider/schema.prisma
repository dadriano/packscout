  provider_invocation_projection_digest  String   @db.Char(64)
  created_at                             DateTime @default(now()) @db.Timestamptz(6)

  activity_event provider_activity_outbox @relation(fields: [activity_event_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "provider_promotion_projection_outbox_activity_fkey")
  invocation     provider_promotion_job_invocations @relation(fields: [invocation_run_id], references: [run_id], onDelete: Cascade, onUpdate: NoAction, map: "provider_promotion_projection_outbox_invocation_fkey")

  @@unique([provider_invocation_id_digest], map: "provider_promotion_projection_outbox_identity_key")
}

/// Replay identity retained independently from the bounded invocation summary.
model provider_promotion_job_delivery_tombstones {
  delivery_key_digest     String   @id @db.Char(64)
  trigger_evidence_digest String   @db.Char(64)
  invocation_run_id       String?  @unique(map: "provider_promotion_job_delivery_tombstones_invocation_key") @db.Uuid
  trigger_kind            String
  issued_at               DateTime @db.Timestamptz(6)
  expires_at              DateTime @db.Timestamptz(6)
  created_at              DateTime @default(now()) @db.Timestamptz(6)

  invocation provider_promotion_job_invocations? @relation(fields: [invocation_run_id], references: [run_id], onDelete: SetNull, onUpdate: NoAction, map: "provider_promotion_job_delivery_tombstones_invocation_fkey")

  @@index([expires_at, delivery_key_digest], map: "provider_promotion_job_delivery_tombstones_expiry_idx")
}

/// Canonical bounded attempt snapshots for one still-retained invocation.
model provider_promotion_invocation_details {
  run_id                     String   @id @db.Uuid
  attempt_count              Int
  operation_count            Int
  attempt_set_digest         String   @db.Char(64)
  canonical_detail_body      String
  canonical_detail_digest    String   @db.Char(64)
  observed_at                DateTime @db.Timestamptz(6)
  created_at                 DateTime @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime @default(now()) @db.Timestamptz(6)

  invocation provider_promotion_job_invocations @relation(fields: [run_id], references: [run_id], onDelete: Cascade, onUpdate: NoAction, map: "provider_promotion_invocation_details_invocation_fkey")
}
