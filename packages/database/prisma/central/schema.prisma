/// Provider-scoped or system-scoped condition episode with retryable delivery.
model promotion_job_liveness_conditions {
  id                               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subject_kind                     String
  subject_key                      String
  organization_id                  String?   @db.Uuid
  provider_id                      String?   @db.Uuid
  schedule_epoch                   BigInt
  condition_state                  String
  anchor_last_scheduled_checkin_at DateTime? @db.Timestamptz(6)
  latest_missed_window_count       BigInt
  opened_at                        DateTime  @db.Timestamptz(6)
  latest_evaluated_at              DateTime  @db.Timestamptz(6)
  resolved_at                      DateTime? @db.Timestamptz(6)
  delivery_action                  String?
  delivery_state                   String?
  delivery_event_id                String?   @db.Uuid
  delivery_attempt_count           Int       @default(0)
  last_delivery_attempt_at         DateTime? @db.Timestamptz(6)
  next_delivery_attempt_at         DateTime? @db.Timestamptz(6)
  last_delivery_failure_code       String?
  row_version                      BigInt    @default(1)
  created_at                       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at                       DateTime  @default(now()) @db.Timestamptz(6)

