  @@index([finished_at, id], map: "provider_promotion_invocation_projections_retention_age_idx")
  @@index([provider_id, finished_at(sort: Desc), id(sort: Desc)], map: "provider_promotion_invocation_projections_retention_rank_idx")
}

/// Durable keyset for bounded, roster-independent provider projection pruning.
model provider_promotion_projection_retention_state {
  singleton_key     Boolean   @id @default(true)
  after_provider_id String?   @db.Uuid
  row_version       BigInt    @default(1)
  updated_at        DateTime  @default(now()) @db.Timestamptz(6)
}
