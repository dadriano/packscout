}

/// Bounded operator-safe summary of one central manifest invocation.
model manifest_reconciliation_job_invocations {
  run_id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  monitoring_order_key       String    @default(dbgenerated()) @db.Char(64)
  delivery_key_digest        String    @unique(map: "manifest_reconciliation_job_invocations_delivery_key") @db.Char(64)
  trigger_evidence_digest    String    @db.Char(64)
  delivery_issued_at         DateTime  @db.Timestamptz(6)
  delivery_expires_at        DateTime  @db.Timestamptz(6)
  trigger_kind               String
  lifecycle_state            String    @default("running")
  outcome                    String?
  observed_wake_generation   BigInt?
  schedule_epoch             BigInt?
  schedule_window_index      BigInt?
  scheduled_due_at           DateTime? @db.Timestamptz(6)
  scheduled_checkin_at       DateTime? @db.Timestamptz(6)
  requested_at               DateTime  @db.Timestamptz(6)
  started_at                 DateTime  @db.Timestamptz(6)
  finished_at                DateTime? @db.Timestamptz(6)
  ownership_key              String?
  ownership_token            String?   @db.Uuid
  ownership_expires_at       DateTime? @db.Timestamptz(6)
  before_lane_position       BigInt?
  after_lane_position        BigInt?
  before_settled_position    BigInt?
  after_settled_position     BigInt?
  cycle_count                Int       @default(0)
  promotion_attempt_count    Int       @default(0)
  publication_count          Int       @default(0)
  operation_count            Int       @default(0)
  related_attempt_count      Int       @default(0)
  related_attempt_set_digest String    @db.Char(64)
  safe_failure_code          String?
  continuation_generation    BigInt?
  result_active_generation   BigInt?
  result_public_release_id   String?   @db.Uuid
  result_release_fingerprint String?   @db.Char(64)
  retention_protected        Boolean   @default(false)
  created_at                 DateTime  @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime  @default(now()) @db.Timestamptz(6)

  delivery_tombstone manifest_reconciliation_job_delivery_tombstones?
  detail             manifest_reconciliation_invocation_details?

  @@index([started_at(sort: Desc), monitoring_order_key(sort: Desc)], map: "manifest_reconciliation_job_invocations_history_idx")
  @@index([ownership_expires_at], map: "manifest_reconciliation_job_invocations_running_idx")
  @@index([finished_at(sort: Desc), run_id(sort: Desc)], map: "manifest_reconciliation_job_invocations_retention_idx")
}

/// Replay identity retained independently from the bounded invocation summary.
model manifest_reconciliation_job_delivery_tombstones {
  delivery_key_digest     String   @id @db.Char(64)
  trigger_evidence_digest String   @db.Char(64)
  invocation_run_id       String?  @unique(map: "manifest_reconciliation_job_delivery_tombstones_invocation_key") @db.Uuid
  trigger_kind            String
  issued_at               DateTime @db.Timestamptz(6)
  expires_at              DateTime @db.Timestamptz(6)
  created_at              DateTime @default(now()) @db.Timestamptz(6)

  invocation manifest_reconciliation_job_invocations? @relation(fields: [invocation_run_id], references: [run_id], onDelete: SetNull, onUpdate: NoAction, map: "manifest_reconciliation_job_delivery_tombstones_invocation_fkey")

  @@index([expires_at, delivery_key_digest], map: "manifest_reconciliation_job_delivery_tombstones_expiry_idx")
}

/// Canonical bounded attempt snapshots for one retained manifest invocation.
model manifest_reconciliation_invocation_details {
  run_id                  String   @id @db.Uuid
  attempt_count           Int
  operation_count         Int
  attempt_set_digest      String   @db.Char(64)
  canonical_detail_body   String
  canonical_detail_digest String   @db.Char(64)
  observed_at             DateTime @db.Timestamptz(6)
  created_at              DateTime @default(now()) @db.Timestamptz(6)
  updated_at              DateTime @default(now()) @db.Timestamptz(6)

  invocation manifest_reconciliation_job_invocations @relation(fields: [run_id], references: [run_id], onDelete: Cascade, onUpdate: NoAction, map: "manifest_reconciliation_invocation_details_invocation_fkey")
}

/// Central-owned pending manifest work. It never commands a provider database.
model manifest_gate_intents {
  provider_id                     String              @id @db.Uuid
  /// Gate-local serial. Provider completion sequences are stored separately.
  requested_generation            BigInt              @default(0)
  acknowledged_generation         BigInt              @default(0)
  latest_cause                    String?
  latest_evidence_digest          String?             @db.Char(64)
  latest_requested_at             DateTime?           @db.Timestamptz(6)
  provider_source_generation      BigInt?
  provider_source_gate_generation BigInt?
  provider_source_cause           String?
  provider_source_evidence_digest String?             @db.Char(64)
  provider_source_requested_at    DateTime?           @db.Timestamptz(6)
  operation_generation            BigInt?
  operation_requested_at          DateTime?           @db.Timestamptz(6)
  requested_operation             manifest_operation?
  target_provider_release_id      String?             @db.Uuid
  target_catalog_version_id       String?             @db.Uuid
  requested_by_operator_id        String?             @db.Uuid
  authorization_digest            String?             @db.Char(64)
  claim_owner                     String?
  claim_token                     String?             @db.Uuid
  claimed_generation              BigInt?
  claimed_work_kind               String?
  claimed_source_generation       BigInt?
  claimed_cause                   String?
  claimed_evidence_digest         String?             @db.Char(64)
  claimed_requested_at            DateTime?           @db.Timestamptz(6)
  claim_expires_at                DateTime?           @db.Timestamptz(6)
  attempt_count                   Int                 @default(0)
  last_attempted_at               DateTime?           @db.Timestamptz(6)
  retry_at                        DateTime?           @db.Timestamptz(6)
  last_failure_code               String?
  row_version                     BigInt              @default(1)
  created_at                      DateTime            @default(now()) @db.Timestamptz(6)
  updated_at                      DateTime            @default(now()) @db.Timestamptz(6)

  provider providers @relation(fields: [provider_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "manifest_gate_intents_provider_fkey")

  @@index([acknowledged_generation, requested_generation, retry_at, last_attempted_at], map: "manifest_gate_intents_pending_idx")
}

/// Idempotent sanitized copy used only for central monitoring/history reads.
model provider_promotion_invocation_projections {
  id                            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  monitoring_order_key          String    @default(dbgenerated()) @db.Char(64)
  organization_id               String    @db.Uuid
  provider_id                   String    @db.Uuid
  provider_invocation_id_digest String    @db.Char(64)
  projection_digest             String    @db.Char(64)
  trigger_kind                  String
  outcome                       String
  scheduled_checkin_at          DateTime? @db.Timestamptz(6)
  started_at                    DateTime  @db.Timestamptz(6)
  finished_at                   DateTime  @db.Timestamptz(6)
  before_lane_position          BigInt?
  after_lane_position           BigInt?
  before_settled_position       BigInt?
  after_settled_position        BigInt?
  cycle_count                   Int
  promotion_attempt_count       Int
  publication_count             Int
  operation_count               Int
  safe_failure_code             String?
  canonical_detail_body         String
  canonical_detail_digest       String    @db.Char(64)
  projected_at                  DateTime  @db.Timestamptz(6)
  created_at                    DateTime  @default(now()) @db.Timestamptz(6)

  provider providers @relation(fields: [provider_id, organization_id], references: [id, organization_id], onDelete: Restrict, onUpdate: NoAction, map: "provider_promotion_invocation_projections_provider_org_fk")

  @@unique([provider_id, provider_invocation_id_digest], map: "provider_promotion_invocation_projections_identity_key")
