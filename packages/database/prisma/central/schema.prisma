  id                         String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider_id                String                      @db.Uuid
  operation                  manifest_operation
  expected_manifest_id       String?
  target_provider_release_id String?                     @db.Uuid
  target_catalog_version_id  String?                     @db.Uuid
  new_manifest_id            String
  new_manifest_fingerprint   String                      @db.Char(64)
  new_manifest_bytes         Bytes
  new_manifest_bytes_hash    String                      @db.Char(64)
  idempotency_key            String                      @unique(map: "manifest_activation_operations_idempotency_unique")
  request_digest             String                      @db.Char(64)
  request_bytes              Bytes
  lease_fence                BigInt
  state                      publication_operation_state @default(pending)
  attempt_count              Int                         @default(0)
  last_attempted_at          DateTime?                   @db.Timestamptz(6)
  completion_lease_fence     BigInt?
  convex_receipt_id          String?
  receipt_hash               String?                     @db.Char(64)
  receipt                    Json?
  receipt_bytes              Bytes?
  response_digest            String?                     @db.Char(64)
  response_bytes             Bytes?
  failure_code               String?
  requested_by_operator_id   String?                     @db.Uuid
  requested_at               DateTime                    @db.Timestamptz(6)
  completed_at               DateTime?                   @db.Timestamptz(6)

  provider               providers                                 @relation(fields: [provider_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "manifest_activation_operations_provider_fk")
  target_catalog_version catalog_versions?                         @relation(fields: [target_catalog_version_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "manifest_activation_operations_catalog_version_fk")
  requested_by_operator  operators?                                @relation(fields: [requested_by_operator_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "manifest_activation_operations_operator_fk")
  status_observations    manifest_activation_status_observations[]
}

/// Exact signed status probes used to recover an ambiguous manifest mutation.
model manifest_activation_status_observations {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  operation_id    String   @db.Uuid
  lease_fence     BigInt
  result_kind     String
  request_digest  String   @db.Char(64)
  request_bytes   Bytes
  receipt_hash    String   @db.Char(64)
  receipt_bytes   Bytes
  response_digest String   @db.Char(64)
  response_bytes  Bytes
  observed_at     DateTime @db.Timestamptz(6)
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  operation manifest_activation_operations @relation(fields: [operation_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "manifest_activation_status_observations_operation_fk")

  @@unique([operation_id, response_digest], map: "manifest_activation_status_observations_response_unique")
  @@index([operation_id, observed_at], map: "manifest_activation_status_observations_operation_idx")
}

/// Exact signed active-state proof used only to adopt or reconcile Convex truth.
model manifest_activation_state_observations {
  id                            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  observation_kind              String
  lease_fence                   BigInt
  active_generation             BigInt
  active_manifest_id            String?
  active_manifest_fingerprint   String?  @db.Char(64)
  active_manifest_bytes         Bytes?
  active_manifest_bytes_hash    String?  @db.Char(64)
  previous_manifest_id          String?
  previous_manifest_fingerprint String?  @db.Char(64)
  previous_manifest_bytes       Bytes?
  previous_manifest_bytes_hash  String?  @db.Char(64)
  active_state_bytes            Bytes
  active_state_hash             String   @db.Char(64)
  request_digest                String   @db.Char(64)
  request_bytes                 Bytes
  convex_receipt_id             String
  receipt_hash                  String   @db.Char(64)
  receipt_bytes                 Bytes
  response_digest               String   @db.Char(64)
  response_bytes                Bytes
  observed_at                   DateTime @db.Timestamptz(6)
  created_at                    DateTime @default(now()) @db.Timestamptz(6)

  @@unique([response_digest, lease_fence], map: "manifest_activation_state_observations_response_unique")
  @@index([active_generation, observed_at], map: "manifest_activation_state_observations_generation_idx")
}

model artifact_retention_executions {
