generator client {
  provider = "prisma-client-js"
  output   = "../generated/central"
}

datasource db {
  provider = "postgresql"
  url      = env("PACKSCOUT_CENTRAL_DATABASE_URL")
}

enum operator_state {
  pending
  active
  disabled
  cancelled
}

enum operator_role {
  admin
  data_operator
}

enum audit_outcome {
  success
  failure
  blocked
}

enum provider_lifecycle {
  draft
  active
  disabled
  archived
}

enum credential_lifecycle {
  active
  retired
  revoked
}

enum credential_kind {
  source
  database
}

enum connection_test_kind {
  source
  database
  activation
}

enum connection_test_outcome {
  succeeded
  failed
}

enum alert_state {
  active
  acknowledged
  resolved
}

enum severity {
  info
  warning
  critical
}

enum catalog_identity_state {
  provisional
  canonical
  retired
}

enum category_kind {
  vertical
  sport
  league
  franchise
  brand
  set
  other
}

enum correlation_method {
  deterministic
  manual
  provisional
}

enum suggestion_state {
  pending
  accepted
  rejected
  superseded
}

enum entity_lifecycle {
  active
  retired
}

enum collectible_type {
  card
  watch
  art
  coin
  sealed_product
  memorabilia
  other
}

enum promotion_operation {
  upsert
  retire
}

enum activity_origin {
  provider
  central
}

enum artifact_lifecycle {
  building
  assembled
  publishing
  complete
  blocked
  failed
}

enum publication_operation_state {
  pending
  accepted
  ambiguous
  failed
}

enum manifest_operation {
  advance
  add
  remove
  rollback
}

enum retention_state {
  running
  succeeded
  failed
}

enum worker_instance_state {
  running
  stopped
}

enum worker_activity_kind {
  idle
  scheduling
  importing
  estimated_ev
  retention
  message_outbox
}

enum email_message_intent_state {
  pending
  retrying
  sent
  skipped
  failed
}

enum email_message_attempt_outcome {
  sent
  skipped
  failed
}

enum email_link_purpose {
  operator_password_reset
  operator_invitation
}

model database_identity {
  singleton_key  Boolean  @id @default(true)
  database_role  String
  schema_version String
  provider_id    String?  @db.Uuid
  provider_key   String?
  created_at     DateTime @default(now()) @db.Timestamptz(6)
}

model organizations {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug       String   @unique(map: "organizations_slug_unique")
  name       String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  operator_memberships     operator_memberships[]
  operator_sessions        operator_sessions[]
  audit_events             audit_events[]
  providers                providers[]
  provider_activity_events provider_activity_events[]
  global_activity_events   global_activity_events[]
  provider_health          provider_health[]
  admin_alerts             admin_alerts[]
}

model operators {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email_normalized String         @unique(map: "operators_email_normalized_unique")
  display_name     String
  password_hash    String?
  state            operator_state @default(active)
  row_version      BigInt         @default(1)
  created_at       DateTime       @default(now()) @db.Timestamptz(6)
  updated_at       DateTime       @default(now()) @db.Timestamptz(6)

  operator_memberships             operator_memberships[]
  operator_sessions                operator_sessions[]
  provider_public_profile_versions provider_public_profile_versions[]
  provider_config_versions         provider_config_versions[]
  provider_connection_tests        provider_connection_tests[]
  manifest_activation_operations   manifest_activation_operations[]
  email_link_tokens                email_link_tokens[]
}

model operator_memberships {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  operator_id     String        @db.Uuid
  role            operator_role
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @default(now()) @db.Timestamptz(6)

  organization organizations       @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "operator_memberships_organization_fk")
  operator     operators           @relation(fields: [operator_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "operator_memberships_operator_fk")
  sessions     operator_sessions[] @relation("OperatorSessionMembership")

  @@unique([organization_id, operator_id], map: "operator_memberships_organization_operator_unique")
  @@index([operator_id], map: "operator_memberships_operator_idx")
}

model operator_sessions {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id     String    @db.Uuid
  operator_id         String    @db.Uuid
  token_hash          String    @unique(map: "operator_sessions_token_hash_unique")
  csrf_hash           String
  idle_expires_at     DateTime  @db.Timestamptz(6)
  absolute_expires_at DateTime  @db.Timestamptz(6)
  last_seen_at        DateTime  @db.Timestamptz(6)
  revoked_at          DateTime? @db.Timestamptz(6)
  created_at          DateTime  @default(now()) @db.Timestamptz(6)

  organization organizations        @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "operator_sessions_organization_fk")
  operator     operators            @relation(fields: [operator_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "operator_sessions_operator_fk")
  membership   operator_memberships @relation("OperatorSessionMembership", fields: [organization_id, operator_id], references: [organization_id, operator_id], onDelete: Restrict, onUpdate: NoAction, map: "operator_sessions_membership_fk")

  @@index([operator_id, created_at], map: "operator_sessions_operator_idx")
}

model auth_rate_limits {
  bucket_key        String    @id
  window_started_at DateTime  @db.Timestamptz(6)
  attempt_count     Int       @default(0)
  blocked_until     DateTime? @db.Timestamptz(6)
  updated_at        DateTime  @default(now()) @db.Timestamptz(6)
}

model audit_events {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String?       @db.Uuid
  actor_key       String
  action          String
  subject_type    String
  subject_id      String?       @db.Uuid
  outcome         audit_outcome
  metadata_json   Json          @default("{}")
  occurred_at     DateTime      @default(now()) @db.Timestamptz(6)

  organization organizations? @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "audit_events_organization_fk")

  @@index([organization_id, occurred_at(sort: Desc)], map: "audit_events_organization_occurred_idx")
}

model worker_instances {
  instance_id                      String                @id
  state                            worker_instance_state @default(running)
  version                          String
  host                             String
  runtime_version                  String
  started_at                       DateTime              @db.Timestamptz(6)
  last_heartbeat_at                DateTime              @db.Timestamptz(6)
  stopped_at                       DateTime?             @db.Timestamptz(6)
  activity_kind                    worker_activity_kind  @default(idle)
  activity_organization_id         String?               @db.Uuid
  activity_provider_id             String?               @db.Uuid
  activity_run_id                  String?               @db.Uuid
  activity_started_at              DateTime?             @db.Timestamptz(6)
  heartbeat_interval_ms            Int
  presence_stale_after_ms          Int
  run_heartbeat_stale_after_ms     Int
  schedule_claim_lease_ms          Int
  import_run_lease_ms              Int
  protected_payload_retention_days Int
  presence_retention_days          Int
  row_version                      BigInt                @default(1)
  created_at                       DateTime              @default(now()) @db.Timestamptz(6)
  updated_at                       DateTime              @default(now()) @db.Timestamptz(6)

  @@index([last_heartbeat_at(sort: Desc)], map: "worker_instances_heartbeat_idx")
  @@index([state, last_heartbeat_at(sort: Desc)], map: "worker_instances_state_heartbeat_idx")
  @@index([activity_organization_id, activity_provider_id], map: "worker_instances_activity_provider_idx")
}

model email_message_intents {
  id                String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind              String
  input_json        Json                       @db.JsonB
  recipient         String
  idempotency_key   String                     @unique(map: "email_message_intents_idempotency_key_unique")
  source            String
  state             email_message_intent_state @default(pending)
  due_at            DateTime                   @db.Timestamptz(6)
  attempt_count     Int                        @default(0)
  claim_owner       String?
  claim_token       String?                    @db.Uuid
  claim_expires_at  DateTime?                  @db.Timestamptz(6)
  last_provider     String?
  last_error_code   String?
  last_skip_reason  String?
  last_attempted_at DateTime?                  @db.Timestamptz(6)
  finalized_at      DateTime?                  @db.Timestamptz(6)
  row_version       BigInt                     @default(1)
  created_at        DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at        DateTime                   @default(now()) @db.Timestamptz(6)

  attempts email_message_attempts[]

  @@index([state, due_at, id], map: "email_message_intents_state_due_idx")
  @@index([source, state], map: "email_message_intents_source_state_idx")
  @@index([created_at(sort: Desc), id(sort: Desc)], map: "email_message_intents_created_idx")
  @@index([state, finalized_at], map: "email_message_intents_state_finalized_idx")
  @@index([recipient, created_at(sort: Desc)], map: "email_message_intents_recipient_created_idx")
}

model email_message_attempts {
  id                  String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  intent_id           String                        @db.Uuid
  attempt_number      Int
  attempted_at        DateTime                      @db.Timestamptz(6)
  outcome             email_message_attempt_outcome
  provider            String?
  provider_message_id String?
  error_code          String?
  error_message       String?
  error_retryable     Boolean?
  skip_reason         String?
  created_at          DateTime                      @default(now()) @db.Timestamptz(6)

  intent email_message_intents @relation(fields: [intent_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "email_message_attempts_intent_fk")

  @@unique([intent_id, attempt_number], map: "email_message_attempts_intent_attempt_unique")
  @@index([attempted_at(sort: Desc)], map: "email_message_attempts_attempted_idx")
}

model email_link_tokens {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purpose            email_link_purpose
  selector           String             @unique(map: "email_link_tokens_selector_unique")
  verifier_hash      String
  subject_id         String             @db.Uuid
  address_normalized String
  issued_at          DateTime           @db.Timestamptz(6)
  expires_at         DateTime           @db.Timestamptz(6)
  redeemed_at        DateTime?          @db.Timestamptz(6)
  superseded_at      DateTime?          @db.Timestamptz(6)
  row_version        BigInt             @default(1)
  created_at         DateTime           @default(now()) @db.Timestamptz(6)
  updated_at         DateTime           @default(now()) @db.Timestamptz(6)

  subject operators @relation(fields: [subject_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "email_link_tokens_subject_fk")

  @@index([purpose, subject_id], map: "email_link_tokens_outstanding_idx")
  @@index([expires_at], map: "email_link_tokens_expiry_idx")
}

model global_activity_events {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  event_digest    String   @db.Char(64)
  event_type      String
  severity        severity
  dedupe_key      String
  recovery_key    String
  title           String
  summary         String
  evidence        Json     @default("{}") @db.JsonB
  event_at        DateTime @db.Timestamptz(6)
  received_at     DateTime @db.Timestamptz(6)
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  organization organizations  @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "global_activity_events_organization_fk")
  alerts       admin_alerts[] @relation("AlertLatestGlobalActivity")

  @@unique([organization_id, id], map: "global_activity_events_organization_id_unique")
  @@unique([organization_id, event_digest], map: "global_activity_events_organization_digest_unique")
  @@index([organization_id, event_at(sort: Desc)], map: "global_activity_events_organization_event_idx")
  @@index([organization_id, dedupe_key, event_at(sort: Desc)], map: "global_activity_events_dedupe_event_idx")
}

model providers {
  id                               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id                  String             @db.Uuid
  provider_key                     String             @db.VarChar(53)
  display_name                     String
  lifecycle                        provider_lifecycle @default(draft)
  active_config_version_id         String?            @db.Uuid
  active_public_profile_version_id String?            @db.Uuid
  topology_version                 BigInt             @default(1)
  row_version                      BigInt             @default(1)
  created_at                       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at                       DateTime           @default(now()) @db.Timestamptz(6)

  organization                     organizations                               @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "providers_organization_fk")
  active_config_version            provider_config_versions?                   @relation("ProviderActiveConfig", fields: [active_config_version_id, id], references: [id, provider_id], onDelete: Restrict, onUpdate: NoAction, map: "providers_active_config_fk")
  active_public_profile_version    provider_public_profile_versions?           @relation("ProviderActiveProfile", fields: [active_public_profile_version_id, id], references: [id, provider_id], onDelete: Restrict, onUpdate: NoAction, map: "providers_active_profile_fk")
  public_profile_versions          provider_public_profile_versions[]          @relation("ProviderProfileVersions")
  config_versions                  provider_config_versions[]                  @relation("ProviderConfigVersions")
  credential_versions              provider_credential_versions[]
  database_nodes                   provider_database_nodes[]                   @relation("ProviderDatabaseNodes")
  connection_tests                 provider_connection_tests[]                 @relation("ProviderConnectionTests")
  activity_events                  provider_activity_events[]                  @relation("ProviderActivityOrganization")
  health                           provider_health[]                           @relation("ProviderHealthOrganization")
  alerts                           admin_alerts[]                              @relation("ProviderAlertOrganization")
  category_correlations            provider_category_correlations[]
  collectible_correlations         provider_collectible_correlations[]
  correlation_suggestions          correlation_suggestions[]
  promotion_changes                catalog_promotion_changes[]
  release_invalidations            provider_release_invalidations[]
  invalidation_checkpoint          provider_invalidation_checkpoints?
  manifest_operations              manifest_activation_operations[]
  manifest_gate_intent             manifest_gate_intents?
  promotion_invocation_projections provider_promotion_invocation_projections[]
  promotion_liveness_observations  promotion_job_liveness_observations[]
  promotion_liveness_conditions    promotion_job_liveness_conditions[]
  completion_publish_plans         provider_completion_publish_plans[]

  @@unique([provider_key], map: "providers_provider_key_unique")
  @@unique([id, organization_id], map: "providers_id_organization_unique")
}

model provider_public_profile_versions {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider_id            String   @db.Uuid
  version_number         BigInt
  display_name           String
  logo_url               String?
  website_url            String?
  listing_hosts          String[]
  image_origins          String[]
  referral_parameters    Json     @default("[]")
  promo_code             String?
  promo_label            String?
  content_hash           String   @db.Char(64)
  created_by_operator_id String   @db.Uuid
  created_at             DateTime @default(now()) @db.Timestamptz(6)

  provider              providers                        @relation("ProviderProfileVersions", fields: [provider_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "provider_public_profile_versions_provider_fk")
  created_by_operator   operators                        @relation(fields: [created_by_operator_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "provider_public_profile_versions_operator_fk")
  active_for_providers  providers[]                      @relation("ProviderActiveProfile")
  release_invalidations provider_release_invalidations[] @relation("InvalidationProfileCause")

  @@unique([provider_id, version_number], map: "provider_public_profile_versions_provider_version_unique")
  @@unique([id, provider_id], map: "provider_public_profile_versions_id_provider_unique")
}

model provider_config_versions {
  id                           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider_id                  String    @db.Uuid
  version_number               BigInt
  adapter_key                  String
  endpoint_url                 String
  source_credential_version_id String?   @db.Uuid
  schedule_seconds             Int
  stale_after_seconds          Int
  configuration                Json      @default("{}")
  expires_at                   DateTime? @db.Timestamptz(6)
  created_by_operator_id       String    @db.Uuid
  created_at                   DateTime  @default(now()) @db.Timestamptz(6)

  provider             providers                     @relation("ProviderConfigVersions", fields: [provider_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "provider_config_versions_provider_fk")
  source_credential    provider_credential_versions? @relation("ConfigSourceCredential", fields: [source_credential_version_id, provider_id], references: [id, provider_id], onDelete: Restrict, onUpdate: NoAction, map: "provider_config_versions_source_credential_fk")
  created_by_operator  operators                     @relation(fields: [created_by_operator_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "provider_config_versions_operator_fk")
  active_for_providers providers[]                   @relation("ProviderActiveConfig")
  connection_tests     provider_connection_tests[]   @relation("ConnectionTestConfig")

  @@unique([provider_id, version_number], map: "provider_config_versions_provider_version_unique")
  @@unique([id, provider_id], map: "provider_config_versions_id_provider_unique")
}

model provider_credential_versions {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider_id     String               @db.Uuid
  credential_kind credential_kind
  version_number  BigInt
  ciphertext      Bytes
  nonce           Bytes
  auth_tag        Bytes
  key_version     Int
  lifecycle       credential_lifecycle @default(active)
  activated_at    DateTime?            @db.Timestamptz(6)
  retired_at      DateTime?            @db.Timestamptz(6)
  revoked_at      DateTime?            @db.Timestamptz(6)
  created_at      DateTime             @default(now()) @db.Timestamptz(6)

  provider                  providers                   @relation(fields: [provider_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "provider_credential_versions_provider_fk")
  source_config_versions    provider_config_versions[]  @relation("ConfigSourceCredential")
  database_nodes            provider_database_nodes[]   @relation("NodeDatabaseCredential")
  source_connection_tests   provider_connection_tests[] @relation("ConnectionTestSourceCredential")
  database_connection_tests provider_connection_tests[] @relation("ConnectionTestDatabaseCredential")

  @@unique([provider_id, credential_kind, version_number], map: "provider_credential_versions_provider_kind_version_unique")
  @@unique([id, provider_id], map: "provider_credential_versions_id_provider_unique")
}

model provider_database_nodes {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider_id           String   @db.Uuid
  node_key              String
  node_role             String
  host                  String
  port                  Int
  database_name         String
  ssl_mode              String
  credential_version_id String   @db.Uuid
  region                String?
  enabled               Boolean
  row_version           BigInt   @default(1)
  created_at            DateTime @default(now()) @db.Timestamptz(6)
  updated_at            DateTime @default(now()) @db.Timestamptz(6)

  provider         providers                    @relation("ProviderDatabaseNodes", fields: [provider_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "provider_database_nodes_provider_fk")
  credential       provider_credential_versions @relation("NodeDatabaseCredential", fields: [credential_version_id, provider_id], references: [id, provider_id], onDelete: Restrict, onUpdate: NoAction, map: "provider_database_nodes_credential_fk")
  connection_tests provider_connection_tests[]  @relation("ConnectionTestDatabaseNode")

  @@unique([provider_id, node_key], map: "provider_database_nodes_provider_node_unique")
  @@unique([id, provider_id], map: "provider_database_nodes_id_provider_unique")
}

model provider_connection_tests {
  id                             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider_id                    String                  @db.Uuid
  config_version_id              String                  @db.Uuid
  source_credential_version_id   String?                 @db.Uuid
  database_credential_version_id String?                 @db.Uuid
  topology_version               BigInt
  database_node_id               String?                 @db.Uuid
  database_node_row_version      BigInt?
  target_digest                  String                  @db.Char(64)
  test_kind                      connection_test_kind
  outcome                        connection_test_outcome
  latency_ms                     Int?
  response_status                Int?
  sanitized_code                 String?
  result_summary                 Json                    @default("{}")
  record_counts                  Json?
  has_more                       Boolean?
  next_cursor_present            Boolean?
  tested_by_operator_id          String                  @db.Uuid
  tested_at                      DateTime                @db.Timestamptz(6)
  created_at                     DateTime                @default(now()) @db.Timestamptz(6)

  provider            providers                     @relation("ProviderConnectionTests", fields: [provider_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "provider_connection_tests_provider_fk")
  config              provider_config_versions      @relation("ConnectionTestConfig", fields: [config_version_id, provider_id], references: [id, provider_id], onDelete: Restrict, onUpdate: NoAction, map: "provider_connection_tests_config_fk")
  source_credential   provider_credential_versions? @relation("ConnectionTestSourceCredential", fields: [source_credential_version_id, provider_id], references: [id, provider_id], onDelete: Restrict, onUpdate: NoAction, map: "provider_connection_tests_source_credential_fk")
  database_credential provider_credential_versions? @relation("ConnectionTestDatabaseCredential", fields: [database_credential_version_id, provider_id], references: [id, provider_id], onDelete: Restrict, onUpdate: NoAction, map: "provider_connection_tests_database_credential_fk")
  database_node       provider_database_nodes?      @relation("ConnectionTestDatabaseNode", fields: [database_node_id, provider_id], references: [id, provider_id], onDelete: Restrict, onUpdate: NoAction, map: "provider_connection_tests_database_node_fk")
  tested_by_operator  operators                     @relation(fields: [tested_by_operator_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "provider_connection_tests_operator_fk")

  @@index([provider_id, config_version_id], map: "provider_connection_tests_provider_config_idx")
  @@index([provider_id, test_kind, tested_at(sort: Desc)], map: "provider_connection_tests_provider_kind_tested_idx")
}

model provider_activity_events {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id     String          @db.Uuid
  provider_id         String          @db.Uuid
  origin              activity_origin
  event_digest        String          @db.Char(64)
  event_type          String
  severity            severity
  dedupe_key          String
  recovery_key        String
  local_run_id        String?         @db.Uuid
  local_quarantine_id String?         @db.Uuid
  title               String
  summary             String
  evidence            Json            @default("{}")
  event_at            DateTime        @db.Timestamptz(6)
  received_at         DateTime        @db.Timestamptz(6)
  created_at          DateTime        @default(now()) @db.Timestamptz(6)

  organization            organizations                      @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "provider_activity_events_organization_fk")
  provider                providers                          @relation("ProviderActivityOrganization", fields: [provider_id, organization_id], references: [id, organization_id], onDelete: Restrict, onUpdate: NoAction, map: "provider_activity_events_provider_organization_fk")
  health_rows             provider_health[]                  @relation("HealthLastActivity")
  alerts                  admin_alerts[]                     @relation("AlertLatestActivity")
  completion_publish_plan provider_completion_publish_plans?

  @@unique([provider_id, id], map: "provider_activity_events_provider_id_unique")
  @@index([organization_id, local_run_id], map: "provider_activity_events_org_local_run_idx")
