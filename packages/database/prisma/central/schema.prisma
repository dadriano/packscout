/// Exact public provider plan and completed-head proof accepted with one
/// provider completion activity event. The provider database remains the
/// authority; this central copy is immutable verified relay evidence.
model provider_completion_publish_plans {
  event_id                          String   @id @db.Uuid
  provider_id                       String   @db.Uuid
  provider_release_id               String   @db.Uuid
  public_provider_release_id        String   @db.Uuid
  provider_release_fingerprint      String   @db.Char(64)
  catalog_version_id                String   @db.Uuid
  catalog_content_hash              String   @db.Char(64)
  provider_release_content_hash     String   @db.Char(64)
  completed_through_change_sequence BigInt
  artifact_attempt_id               String   @db.Uuid
  terminal_operation_kind           String
  terminal_operation_id             String
  terminal_receipt_sha256           String   @db.Char(64)
  evidence_digest                   String   @db.Char(64)
  plan_sha256                       String   @db.Char(64)
  plan_bytes                        Bytes    @db.ByteA
  completed_head_sha256             String   @db.Char(64)
  completed_head_bytes              Bytes    @db.ByteA
  active_observation_sha256         String   @db.Char(64)
  active_observation_bytes          Bytes    @db.ByteA
  verified_at                       DateTime @db.Timestamptz(6)
  created_at                        DateTime @default(now()) @db.Timestamptz(6)

  provider        providers                @relation(fields: [provider_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "provider_completion_publish_plans_provider_fk")
  catalog_version catalog_versions         @relation(fields: [catalog_version_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "provider_completion_publish_plans_catalog_version_fk")
  activity_event  provider_activity_events @relation(fields: [provider_id, event_id], references: [provider_id, id], onDelete: Restrict, onUpdate: NoAction, map: "provider_completion_publish_plans_activity_event_fk")

  @@unique([provider_id, evidence_digest], map: "provider_completion_publish_plans_provider_evidence_key")
  @@unique([provider_id, artifact_attempt_id], map: "provider_completion_publish_plans_provider_attempt_key")
  @@unique([provider_id, event_id], map: "provider_completion_plans_provider_event_key")
  @@unique([provider_id, provider_release_id, completed_through_change_sequence], map: "provider_completion_plans_release_generation_key")
  @@index([provider_id, public_provider_release_id, provider_release_fingerprint, completed_through_change_sequence(sort: Desc)], map: "provider_completion_publish_plans_manifest_lookup_idx")
  @@index([verified_at, event_id], map: "provider_completion_publish_plans_retention_idx")
}

