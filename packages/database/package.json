{
  "name": "@packscout/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./protected-evidence": "./src/protected-evidence.ts",
    "./test-support": "./src/test-support.ts"
  },
  "scripts": {
    "lint": "eslint src prisma",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/run-tests.mjs database",
    "prisma:validate": "npm run prisma:validate:central && npm run prisma:validate:provider",
    "prisma:validate:central": "PACKSCOUT_CENTRAL_DATABASE_URL=postgresql://packscout:packscout@127.0.0.1:1/packscout_schema_tooling prisma validate --schema prisma/central/schema.prisma",
    "prisma:validate:provider": "PACKSCOUT_PROVIDER_DATABASE_URL=postgresql://packscout:packscout@127.0.0.1:1/packscout_schema_tooling prisma validate --schema prisma/provider/schema.prisma",
    "prisma:generate": "npm run prisma:generate:legacy && npm run prisma:generate:central && npm run prisma:generate:provider",
    "prisma:generate:legacy": "PACKSCOUT_DATABASE_URL=postgresql://packscout:packscout@127.0.0.1:1/packscout_schema_tooling prisma generate --schema prisma/schema.prisma",
    "prisma:generate:central": "PACKSCOUT_CENTRAL_DATABASE_URL=postgresql://packscout:packscout@127.0.0.1:1/packscout_schema_tooling prisma generate --schema prisma/central/schema.prisma",
    "prisma:generate:provider": "PACKSCOUT_PROVIDER_DATABASE_URL=postgresql://packscout:packscout@127.0.0.1:1/packscout_schema_tooling prisma generate --schema prisma/provider/schema.prisma",
    "prisma:migrate:deploy:central": "node -e \"if (!process.env.PACKSCOUT_CENTRAL_DATABASE_URL) { console.error('PACKSCOUT_CENTRAL_DATABASE_URL is required for central migration deploy.'); process.exit(1); }\" && prisma migrate deploy --schema prisma/central/schema.prisma",
    "prisma:migrate:deploy:provider": "node -e \"if (!process.env.PACKSCOUT_PROVIDER_DATABASE_URL) { console.error('PACKSCOUT_PROVIDER_DATABASE_URL is required for provider migration deploy.'); process.exit(1); }\" && prisma migrate deploy --schema prisma/provider/schema.prisma",
    "test:prisma-schema": "node --import tsx --test 'prisma/**/*.test.ts'",
    "test:prisma-lifecycle": "node --import tsx --test 'src/database.lifecycle.test.ts'",
    "test:prisma-setup": "node --import tsx --test 'src/setup-repository.test.ts'"
  },
  "dependencies": {
    "@packscout/contracts": "0.0.0",
    "@prisma/client": "^6.19.3",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^20",
    "@types/pg": "^8.15.6",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1"
  }
}
